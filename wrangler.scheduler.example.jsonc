{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bridgestar-contract-maintenance",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bridgestar-contracts-production",
      "database_id": "REPLACE_WITH_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "bridgestar-contracts-documents"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://contracts.bridgestar.jp",
    "ENVIRONMENT": "production",
    "AUTH_MODE": "email",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "MAIL_FROM": "中高一貫ブリッジスター <no-reply@threestars-online.app>",
    "LIVE_SEND_ENABLED": "false"
  },
  "main": "src/scheduler.ts",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": [
      "*/10 * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  }
}
